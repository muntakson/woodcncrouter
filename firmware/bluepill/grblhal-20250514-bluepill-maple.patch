diff --git a/STM32F103C8TX_FLASH.ld b/STM32F103C8TX_FLASH.ld
index d814cbd..55d0d35 100644
--- a/STM32F103C8TX_FLASH.ld
+++ b/STM32F103C8TX_FLASH.ld
@@ -55,7 +55,10 @@ ENTRY(Reset_Handler)
 /* Highest address of the user mode stack */
 _estack = 0x20005000;	/* end of "RAM" Ram type memory */
 
-_Min_Heap_Size = 0x1000 ;	/* required amount of heap  */
+_Min_Heap_Size = 0xE00 ;	/* minimum heap reserved at link time; the planner sizes itself from what is free at run time */
+
+/* woodcncrouter: -Wl,--defsym=LD_VECT_TAB_OFFSET=0x2000 places the firmware above the STM32duino bootloader */
+LD_VECT_TAB_OFFSET = DEFINED(LD_VECT_TAB_OFFSET) ? LD_VECT_TAB_OFFSET : 0;
 _Min_Stack_Size = 0x800 ;	/* required amount of stack */
 
 /* Memories definition */
@@ -63,7 +66,7 @@ MEMORY
 {
   RAM(rwx)         : ORIGIN = 0x20000000, LENGTH = 20K
   EEPROM_EMUL(xrw) : ORIGIN = 0x801F800,  LENGTH = 2K
-  FLASH(rx)	       : ORIGIN = 0x8000000,  LENGTH = 128K - 2K
+  FLASH(rx)	       : ORIGIN = 0x8000000 + LD_VECT_TAB_OFFSET,  LENGTH = 128K - 2K - LD_VECT_TAB_OFFSET
 }
 
 _EEPROM_Emul_Start = ORIGIN(EEPROM_EMUL);
diff --git a/platformio.ini b/platformio.ini
index fafa86a..c41aded 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -151,4 +151,26 @@ build_flags = ${common.build_flags}
 lib_deps = ${common.lib_deps}
   eeprom
 lib_extra_dirs = ${common.lib_extra_dirs}
-upload_protocol = stlink
\ No newline at end of file
+upload_protocol = stlink
+# --- woodcncrouter: Blue Pill with the STM32duino (Maple DFU) bootloader 2.0 ----------
+# Firmware starts at 0x08002000 above the 8 KB bootloader; flashed over USB DFU
+# (dfu-util -a 2 / Grbl Sender app). USB CDC serial to the tablet.
+[env:bluepill_f103c8_128k_USB_maple]
+board = bluepill_f103c8_128k
+board_build.ldscript = STM32F103C8TX_FLASH.ld
+build_flags = ${common.build_flags}
+  -D BOARD_CNC3040=
+  -D NO_SETTINGS_DESCRIPTIONS=
+  -D USB_SERIAL_CDC=1
+  -D VECT_TAB_OFFSET=0x2000
+  -Wl,--defsym=LD_VECT_TAB_OFFSET=0x2000
+  # link-time optimisation: needed to fit 118 KB (128 KB - 8 KB bootloader - 2 KB settings)
+  -flto
+  -DCOMPATIBILITY_LEVEL=10
+  -DNGC_PARAMETERS_ENABLE=0
+lib_deps = ${common.lib_deps}
+  eeprom
+lib_extra_dirs = ${common.lib_extra_dirs}
+upload_protocol = dfu
+# GCC 7.2 (platform default) produces ~130 KB; a modern GCC is needed to fit 118 KB
+platform_packages = platformio/toolchain-gccarmnoneeabi@~1.120301.0
