+/*******************************************************************************
+ * Description    : Force the host to re-enumerate the device.
+ * The Blue/Black Pill has no D+ switch, only a fixed 1.5k pull-up on PA12. After the
+ * STM32duino bootloader jumps here, some hosts (an Android tablet) never notice
+ * that the DFU device has gone and never see this CDC device. Holding D+ low for
+ * about 20 ms before the USB peripheral starts looks like an unplug to any host.
+ *******************************************************************************/
+void USB_Reenumerate(void)
+{
+	GPIO_InitTypeDef gpio;
+	volatile uint32_t i;
+
+	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);
+	gpio.GPIO_Pin = GPIO_Pin_12;
+	gpio.GPIO_Speed = GPIO_Speed_2MHz;
+	gpio.GPIO_Mode = GPIO_Mode_Out_PP;
+	GPIO_Init(GPIOA, &gpio);
+	GPIO_ResetBits(GPIOA, GPIO_Pin_12);
+	for (i = 0; i < 400000; i++)	/* >= 20 ms at 72 MHz */
+		;
+	gpio.GPIO_Mode = GPIO_Mode_IN_FLOATING;
+	GPIO_Init(GPIOA, &gpio);
+}
+
