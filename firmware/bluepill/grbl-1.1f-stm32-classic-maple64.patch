diff --git a/src/diag.c b/src/diag.c
new file mode 100644
index 0000000..5b821c7
--- /dev/null
+++ b/src/diag.c
@@ -0,0 +1,102 @@
+/*
+  diag.c - wiring diagnostics: a 1 kHz, 50 % square wave on the X step pin
+
+  M150 P<s> toggles the X step pin from TIM4 (free in this port) for P seconds, without
+  the stepper code, so a scope sees a clean 1 kHz / 50 % wave and the pin itself is tested.
+  It waits for motion to finish first; any new motion (st_wake_up) or a reset stops it.
+*/
+#include "grbl.h"
+
+#ifdef STM32F103C8
+
+static volatile uint32_t diag_toggles_left;
+
+static void diag_pin_low(void)
+{
+  // idle level: low, or high when $2 inverts the X step pulse
+  if (settings.step_invert_mask & bit(X_AXIS)) STEP_PORT->ODR |= (1 << X_STEP_BIT);
+  else STEP_PORT->ODR &= ~(1 << X_STEP_BIT);
+}
+
+void diag_stop(void)
+{
+  TIM4->CR1 &= ~TIM_CR1_CEN;
+  TIM4->DIER &= ~TIM_DIER_UIE;
+  if (diag_toggles_left) {
+    diag_toggles_left = 0;
+    diag_pin_low();
+  }
+}
+
+uint8_t diag_active(void) { return diag_toggles_left != 0; }
+
+static void diag_start(uint32_t seconds)
+{
+  GPIO_InitTypeDef gpio;
+
+  diag_stop();
+  if (seconds == 0) return;
+
+  // make sure the pin really is a push-pull output
+  RCC_APB2PeriphClockCmd(RCC_STEP_PORT, ENABLE);
+  gpio.GPIO_Pin = 1 << X_STEP_BIT;
+  gpio.GPIO_Speed = GPIO_Speed_50MHz;
+  gpio.GPIO_Mode = GPIO_Mode_Out_PP;
+  GPIO_Init(STEP_PORT, &gpio);
+  diag_pin_low();
+
+  // TIM4 on APB1 runs at 72 MHz: 72 MHz / 72 = 1 MHz count, update every 500 us = 2 kHz toggles
+  RCC->APB1ENR |= RCC_APB1Periph_TIM4;
+  TIM4->CR1 = 0;
+  TIM4->PSC = (F_CPU / 1000000) - 1;
+  TIM4->ARR = (1000000 / (2 * DIAG_PULSE_HZ)) - 1;
+  TIM4->CNT = 0;
+  TIM4->EGR = TIM_EGR_UG;
+  TIM4->SR = ~TIM_SR_UIF;
+  diag_toggles_left = seconds * 2 * DIAG_PULSE_HZ;
+  NVIC_SetPriority(TIM4_IRQn, 2);   // below the stepper timers (0, 1)
+  NVIC_EnableIRQ(TIM4_IRQn);
+  TIM4->DIER |= TIM_DIER_UIE;
+  TIM4->CR1 |= TIM_CR1_CEN;
+}
+
+void TIM4_IRQHandler(void)
+{
+  TIM4->SR = ~TIM_SR_UIF;
+  if (diag_toggles_left == 0) { TIM4->CR1 &= ~TIM_CR1_CEN; return; }
+  STEP_PORT->ODR ^= (1 << X_STEP_BIT);
+  if (--diag_toggles_left == 0) {
+    TIM4->CR1 &= ~TIM_CR1_CEN;
+    diag_pin_low();
+  }
+}
+
+uint8_t diag_execute_line(char *line)
+{
+  uint8_t i = 1;
+  float value;
+  uint32_t seconds = DIAG_DEFAULT_S;
+
+  // protocol has already removed spaces and upper-cased the line
+  if (line[0] != 'M') return 0xFF;
+  if (!read_float(line, &i, &value) || value != DIAG_MCODE_PULSE) return 0xFF;
+  if (line[i] == 'P') {
+    i++;
+    if (!read_float(line, &i, &value) || value < 0 || value > 600) return STATUS_GCODE_VALUE_WORD_MISSING;
+    seconds = (uint32_t)value;
+  }
+  if (line[i] != 0) return STATUS_GCODE_UNSUPPORTED_COMMAND;
+  if (sys.state & (STATE_ALARM | STATE_JOG | STATE_CHECK_MODE)) return STATUS_SYSTEM_GC_LOCK;
+  protocol_buffer_synchronize();   // let queued motion finish: the stepper owns the pin while it runs
+  if (sys.abort) return STATUS_OK;
+  diag_start(seconds);
+  return STATUS_OK;
+}
+
+#else
+
+uint8_t diag_execute_line(char *line) { return 0xFF; }
+void diag_stop(void) { }
+uint8_t diag_active(void) { return 0; }
+
+#endif
