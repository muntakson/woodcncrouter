diff --git a/Makefile.maple b/Makefile.maple
new file mode 100644
index 0000000..3d786d5
--- /dev/null
+++ b/Makefile.maple
@@ -0,0 +1,38 @@
+# Grbl 1.1f (robomechs STM32 port) for a 64 KB Blue Pill with the STM32duino/Maple
+# bootloader: firmware at 0x08002000, settings in the last 1 KB page (0x0800FC00),
+# native USB CDC (0483:5740).   make -f Makefile.maple
+CC      = arm-none-eabi-gcc
+OBJCOPY = arm-none-eabi-objcopy
+SIZE    = arm-none-eabi-size
+BUILD   = build-maple64
+TARGET  = $(BUILD)/grbl-1.1f-bluepill64-maple
+
+DEFS = -DSTM32F103C8 -DSTM32F103C8T6 -DSTM32F10X_MD -DUSE_STDPERIPH_DRIVER -DUSEUSB -DLEDBLINK \
+       -DVECT_TAB_OFFSET=0x2000 -DEEPROM_START_ADDRESS=0x0800FC00
+INCS = -Iinc -Iutil -Iusb -Istm_usb_fs_lib/inc \
+       -ILibraries/CMSIS/Include -ILibraries/CMSIS/Device/ST/STM32F10x/Include \
+       -ILibraries/STM32F10x_StdPeriph_Driver/inc
+ARCH = -mcpu=cortex-m3 -mthumb
+CFLAGS  = $(ARCH) -Os -flto -ffunction-sections -fdata-sections -std=gnu99 -Wall -Wno-unused $(DEFS) $(INCS)
+LDFLAGS = $(ARCH) -Os -flto -Tstm32_flash_maple64.ld -Wl,--gc-sections -Wl,-Map=$(TARGET).map \
+          --specs=nano.specs --specs=nosys.specs -lm
+
+SRCS = $(wildcard src/*.c) $(wildcard util/*.c) $(wildcard usb/*.c) $(wildcard stm_usb_fs_lib/src/*.c) \
+       $(wildcard Libraries/STM32F10x_StdPeriph_Driver/src/*.c)
+ASMS = src/startup_stm32f10x_md.s
+OBJS = $(patsubst %.c,$(BUILD)/%.o,$(SRCS)) $(patsubst %.s,$(BUILD)/%.o,$(ASMS))
+
+all: $(TARGET).bin
+$(BUILD)/%.o: %.c
+	@mkdir -p $(dir $@)
+	@$(CC) $(CFLAGS) -c $< -o $@
+$(BUILD)/%.o: %.s
+	@mkdir -p $(dir $@)
+	@$(CC) $(ARCH) -c $< -o $@
+$(TARGET).elf: $(OBJS)
+	$(CC) $(LDFLAGS) $(OBJS) -o $@
+	$(SIZE) $@
+$(TARGET).bin: $(TARGET).elf
+	$(OBJCOPY) -O binary $< $@
+clean:
+	rm -rf $(BUILD)
diff --git a/inc/diag.h b/inc/diag.h
new file mode 100644
index 0000000..bbc0c19
--- /dev/null
+++ b/inc/diag.h
@@ -0,0 +1,17 @@
+/*
+  diag.h - wiring diagnostics: a 1 kHz, 50 % square wave on the X step pin
+*/
+#ifndef diag_h
+#define diag_h
+
+// M150 P<s>: square wave on the X step pin for P seconds (default 10, P0 stops it)
+#define DIAG_MCODE_PULSE  150
+#define DIAG_PULSE_HZ     1000
+#define DIAG_DEFAULT_S    10
+
+// Handles "M150[P<s>]" lines; returns STATUS_OK or an error, or 0xFF when the line is not M150.
+uint8_t diag_execute_line(char *line);
+void diag_stop(void);
+uint8_t diag_active(void);
+
+#endif
