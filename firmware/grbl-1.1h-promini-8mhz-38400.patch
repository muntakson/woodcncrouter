diff --git a/grbl/diag.c b/grbl/diag.c
new file mode 100644
index 0000000..28db562
--- /dev/null
+++ b/grbl/diag.c
@@ -0,0 +1,91 @@
+/*
+  diag.c - wiring diagnostics: 1 kHz, 100 us wide pulses on a step pin
+
+  M150 [X|Y|Z|A] P<s> pulses that axis's step pin (X when no axis is given; A is the spare A4 pin)
+  for P seconds without the stepper code, so a scope sees clean 1 kHz / 100 us pulses and the pin
+  itself is tested. Timer0 (only used by the stepper for the step pulse width, idle between moves)
+  runs in CTC mode at 10 kHz: tick 0 starts the pulse, tick 1 ends it, ticks 2-9 stay idle.
+  It waits for motion to finish first; any new motion (st_wake_up) or a reset stops it.
+*/
+#include "grbl.h"
+
+#ifdef STEP_PULSE_DELAY
+  #error "diag.c uses TIMER0_COMPA_vect, which STEP_PULSE_DELAY needs"
+#endif
+
+static volatile uint32_t diag_ms_left;
+static volatile uint8_t *diag_port;
+static uint8_t diag_mask, diag_tick;
+
+void diag_stop(void)
+{
+  // back to the stepper's Timer0 setup (see stepper_init)
+  TCCR0B = 0;
+  TCCR0A = 0;
+  TIMSK0 = (1<<TOIE0);
+  if (diag_ms_left) {
+    if (diag_tick == 1) *diag_port ^= diag_mask;   // stopped inside a pulse: back to idle
+    diag_ms_left = 0;
+  }
+}
+
+ISR(TIMER0_COMPA_vect)
+{
+  if (diag_tick == 0) *diag_port ^= diag_mask;        // pulse starts
+  else if (diag_tick == 1) {
+    *diag_port ^= diag_mask;                          // pulse ends after 100 us
+    if (--diag_ms_left == 0) { TCCR0B = 0; TIMSK0 = (1<<TOIE0); TCCR0A = 0; }
+  }
+  if (++diag_tick == 10) diag_tick = 0;
+}
+
+uint8_t diag_execute_line(char *line)
+{
+  uint8_t i = 1;
+  float value;
+  uint32_t seconds = DIAG_DEFAULT_S;
+  uint8_t axis = X_AXIS;
+
+  // protocol has already removed spaces and upper-cased the line
+  if (line[0] != 'M') return 0xFF;
+  if (!read_float(line, &i, &value) || value != DIAG_MCODE_PULSE) return 0xFF;
+  switch (line[i]) {
+    case 'X': i++; break;
+    case 'Y': i++; axis = Y_AXIS; break;
+    case 'Z': i++; axis = Z_AXIS; break;
+    case 'A': i++; axis = N_AXIS; break;
+  }
+  if (line[i] == 'P') {
+    i++;
+    if (!read_float(line, &i, &value) || value < 0 || value > 600) return STATUS_GCODE_VALUE_WORD_MISSING;
+    seconds = (uint32_t)value;
+  }
+  if (line[i] != 0) return STATUS_GCODE_UNSUPPORTED_COMMAND;
+  if (sys.state & (STATE_ALARM | STATE_JOG | STATE_CHECK_MODE)) return STATUS_SYSTEM_GC_LOCK;
+  protocol_buffer_synchronize();   // let queued motion finish: the stepper owns the step pins while it runs
+  if (sys.abort) return STATUS_OK;
+
+  diag_stop();
+  if (seconds == 0) return STATUS_OK;
+  if (axis == N_AXIS) {
+    DIAG_A_DDR |= (1<<DIAG_A_BIT);
+    DIAG_A_PORT &= ~(1<<DIAG_A_BIT);
+    diag_port = &DIAG_A_PORT;
+    diag_mask = 1<<DIAG_A_BIT;
+  } else {
+    // step pins idle at the $2 (step invert) level, set by st_go_idle; toggling keeps that polarity
+    diag_port = &STEP_PORT;
+    diag_mask = get_step_pin_mask(axis);
+  }
+  diag_tick = 2;                   // first pulse after 0.8 ms
+  diag_ms_left = seconds * 1000;
+  // Timer0: CTC, 8 MHz / 8 = 1 MHz, compare every 100 us
+  TCCR0B = 0;
+  TCNT0 = 0;
+  OCR0A = (F_CPU / 8 / 10000) - 1;
+  TCCR0A = (1<<WGM01);
+  TIFR0 = (1<<OCF0A) | (1<<TOV0);
+  TIMSK0 = (1<<OCIE0A);
+  TCCR0B = (1<<CS01);
+  return STATUS_OK;
+}
diff --git a/grbl/diag.h b/grbl/diag.h
new file mode 100644
index 0000000..9db5493
--- /dev/null
+++ b/grbl/diag.h
@@ -0,0 +1,20 @@
+/*
+  diag.h - wiring diagnostics: 1 kHz, 100 us wide pulses on a step pin
+*/
+#ifndef diag_h
+#define diag_h
+
+// M150 [X|Y|Z|A] P<s>: pulses on that axis's step pin (default X) for P seconds (default 10, P0 stops it)
+#define DIAG_MCODE_PULSE  150
+#define DIAG_DEFAULT_S    10
+
+// Test-only A step pin: A4 (coolant mist, unused without ENABLE_M7). Grbl on the 328P has no A axis.
+#define DIAG_A_DDR   DDRC
+#define DIAG_A_PORT  PORTC
+#define DIAG_A_BIT   4
+
+// Handles "M150[X|Y|Z|A][P<s>]" lines; returns STATUS_OK or an error, or 0xFF when the line is not M150.
+uint8_t diag_execute_line(char *line);
+void diag_stop(void);
+
+#endif
