diff --git a/FluidNC/src/Diag.cpp b/FluidNC/src/Diag.cpp
new file mode 100644
index 0000000..d7ed9eb
--- /dev/null
+++ b/FluidNC/src/Diag.cpp
@@ -0,0 +1,225 @@
+// Wiring check for the woodcncrouter (github.com/mtshon/woodcncrouter), same command as its Grbl builds:
+//
+//   M150 [X|Y|Z|A] P<s>   1 kHz pulses, 100 us high, on that axis's step output for <s> seconds
+//                         (default axis X, default 10 s, at most 60 s); P0 stops a running test
+//   M150 [X|Y|Z|A] D1|D0  sets that axis's direction output high / low (electrical level, no step)
+//
+// Only while Idle; nothing moves in the planner and positions are not changed. The outputs are driven
+// through their Pin objects, so it works for gpio and i2so (shift register) step pins alike: with the
+// I2S engine the pulse ISR runs all the time and picks the writes up within a few microseconds.
+
+#include "Diag.h"
+
+#include "Machine/MachineConfig.h"
+#include "Machine/Axes.h"
+#include "Motors/MotorDriver.h"
+#include "System.h"
+#include "Logging.h"
+#include "Driver/delay_usecs.h"
+#include "Platform.h"  // IRAM_ATTR
+
+#include <cctype>
+#include <cstdlib>
+
+#ifdef ESP_PLATFORM
+#    include "esp_timer.h"
+#endif
+
+namespace {
+    constexpr int PULSE_PERIOD_US = 1000;
+    constexpr int PULSE_HIGH_US   = 100;
+    constexpr int DEFAULT_SECONDS = 10;
+    constexpr int MAX_SECONDS     = 60;
+
+    Pin* volatile pulse_pin   = nullptr;
+    volatile bool pulse_inv   = false;
+    volatile int64_t end_us   = 0;
+
+#ifdef ESP_PLATFORM
+    esp_timer_handle_t timer = nullptr;
+
+    void stop_pulse() {
+        if (timer) {
+            esp_timer_stop(timer);
+        }
+        Pin* p = pulse_pin;
+        if (p) {
+            p->write(pulse_inv);  // electrical low
+        }
+        pulse_pin = nullptr;
+    }
+
+    void pulse_cb(void*) {
+        Pin* p = pulse_pin;
+        if (!p) {
+            return;
+        }
+        if (esp_timer_get_time() >= end_us) {
+            p->write(pulse_inv);
+            pulse_pin = nullptr;
+            esp_timer_stop(timer);
+            return;
+        }
+        p->write(!pulse_inv);  // electrical high
+        delay_us(PULSE_HIGH_US);
+        p->write(pulse_inv);
+    }
+
+    bool start_pulse(Pin* pin, int seconds) {
+        if (!timer) {
+            esp_timer_create_args_t args = {};
+            args.callback                = pulse_cb;
+            args.name                    = "m150";
+            if (esp_timer_create(&args, &timer) != ESP_OK) {
+                return false;
+            }
+        }
+        stop_pulse();
+        pulse_inv = pin->inverted();
+        end_us    = esp_timer_get_time() + int64_t(seconds) * 1000000;
+        pulse_pin = pin;
+        return esp_timer_start_periodic(timer, PULSE_PERIOD_US) == ESP_OK;
+    }
+#else
+    void stop_pulse() { pulse_pin = nullptr; }
+    bool start_pulse(Pin*, int) { return false; }
+#endif
+
+    // Parses an unsigned number after a letter; returns false if there is none.
+    bool number(const char*& s, float& value) {
+        char* end;
+        value = strtof(s, &end);
+        if (end == s) {
+            return false;
+        }
+        s = end;
+        return true;
+    }
+
+    MotorDrivers::MotorDriver* driver(int axis) {
+        auto axes = config->_axes;
+        if (!axes || axis >= axes->_numberAxis) {
+            return nullptr;
+        }
+        auto a = axes->_axis[axis];
+        if (!a || !a->_motors[0]) {
+            return nullptr;
+        }
+        return a->_motors[0]->_driver;
+    }
+}
+
+bool diag_m150(const char* line, Channel& out, Error& result) {
+    // Match "M150" (any case, spaces allowed, leading zeros of the number allowed)
+    const char* s = line;
+    while (*s == ' ') {
+        ++s;
+    }
+    if (toupper(*s) != 'M') {
+        return false;
+    }
+    ++s;
+    char* end;
+    long  code = strtol(s, &end, 10);
+    if (end == s || code != 150 || *end == '.') {
+        return false;
+    }
+    s = end;
+
+    int   axis    = 0;
+    bool  have_p  = false, have_d = false;
+    float p       = DEFAULT_SECONDS, d = 0;
+    while (*s) {
+        char c = toupper(*s++);
+        if (c == ' ') {
+            continue;
+        }
+        switch (c) {
+            case 'X':
+                axis = 0;
+                break;
+            case 'Y':
+                axis = 1;
+                break;
+            case 'Z':
+                axis = 2;
+                break;
+            case 'A':
+                axis = 3;
+                break;
+            case 'P':
+                if (!number(s, p) || p < 0) {
+                    result = Error::BadNumberFormat;
+                    return true;
+                }
+                have_p = true;
+                break;
+            case 'D':
+                if (!number(s, d) || (d != 0 && d != 1)) {
+                    result = Error::BadNumberFormat;
+                    return true;
+                }
+                have_d = true;
+                break;
+            default:
+                result = Error::GcodeUnsupportedCommand;
+                return true;
+        }
+        // An axis letter may carry a number ("X0"); ignore it
+        if (c == 'X' || c == 'Y' || c == 'Z' || c == 'A') {
+            float ignored;
+            number(s, ignored);
+        }
+    }
+
+    if (have_p && p == 0) {
+        stop_pulse();
+        log_info_to(out, "M150: test stopped");
+        result = Error::Ok;
+        return true;
+    }
+    if (!state_is(State::Idle)) {
+        result = Error::IdleError;
+        return true;
+    }
+    auto drv = driver(axis);
+    Pin* pin = nullptr;
+    if (drv) {
+        pin = have_d ? drv->diag_dir_pin() : drv->diag_step_pin();
+    }
+    if (!pin || !pin->defined()) {
+        log_error_to(out, "M150: axis " << "XYZA"[axis] << " has no " << (have_d ? "direction" : "step") << " pin");
+        result = Error::GcodeUnsupportedCommand;
+        return true;
+    }
+
+    if (have_d) {
+        pin->write((d != 0) ^ pin->inverted());  // electrical level
+        log_info_to(out, "M150: " << "XYZA"[axis] << " dir " << pin->name() << (d != 0 ? " high" : " low"));
+        result = Error::Ok;
+        return true;
+    }
+
+    int seconds = int(p + 0.5f);
+    if (seconds > MAX_SECONDS) {
+        seconds = MAX_SECONDS;
+    }
+    if (seconds < 1) {
+        seconds = 1;
+    }
+    if (!start_pulse(pin, seconds)) {
+        result = Error::GcodeUnsupportedCommand;
+        return true;
+    }
+    log_info_to(out, "M150: 1 kHz, " << PULSE_HIGH_US << " us pulses on " << "XYZA"[axis] << " step " << pin->name() << " for " << seconds << " s");
+    result = Error::Ok;
+    return true;
+}
+
+void diag_stop() {
+    stop_pulse();
+}
+
+void IRAM_ATTR diag_end() {
+    end_us = 0;
+}
diff --git a/FluidNC/src/Diag.h b/FluidNC/src/Diag.h
new file mode 100644
index 0000000..4361beb
--- /dev/null
+++ b/FluidNC/src/Diag.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include "Error.h"
+#include "Channel.h"
+
+// M150 wiring check (see Diag.cpp). Returns true when the line was an M150 command; result holds its status.
+bool diag_m150(const char* line, Channel& out, Error& result);
+
+// Stops a running M150 pulse test (called on reset and before motion).
+void diag_stop();
+
+// ISR-safe: makes a running M150 pulse test end at its next tick.
+void diag_end();
