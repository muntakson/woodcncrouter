PORT=3077
# Shared key the app sends with log uploads; also baked into the APK at build time
INGEST_KEY=change-me
# Dashboard login for access through the public URL (the LAN needs none)
DASH_USER=admin
DASH_PASSWORD=change-me
# Bearer token for the remote-control API (/api/cnc/*); the dashboard login works too
CNC_API_KEY=change-me
