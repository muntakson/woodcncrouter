<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Btn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <!-- Toolbar button -->
    <style name="Tb">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Tab">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Jog">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Radio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Jog step: a segmented button instead of a radio dot -->
    <style name="Seg">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/seg_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Fixed-height action button in the machine panel -->
    <style name="BtnRow" parent="Btn">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
    </style>
</resources>
