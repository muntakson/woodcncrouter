<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented toggle (jog step): checked = cyan outline -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3300E5FF">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#2200E5FF" />
                    <stroke android:width="1dp" android:color="#00E5FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#18202A" />
                    <stroke android:width="1dp" android:color="#2A3644" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
