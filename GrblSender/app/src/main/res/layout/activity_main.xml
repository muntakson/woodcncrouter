<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <!-- Title bar: logo, app name + open file, live status chips -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/titlebar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Grbl Sender"
            android:src="@drawable/ic_launcher_fg"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="GRBL SENDER"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxWidth="360dp"
                android:singleLine="true"
                android:text="No file"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView android:id="@+id/chipUsb" style="@style/Chip" android:text="● USB" />
        <TextView android:id="@+id/chipMachine" style="@style/Chip" android:text="● —" />
        <TextView android:id="@+id/chipCloud" style="@style/Chip" android:text="● Backoffice" />
        <TextView android:id="@+id/chipRemote" style="@style/Chip" android:text="● Remote" />
        <TextView android:id="@+id/chipCamera" style="@style/Chip" android:text="● Camera LIVE" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Navigation rail (landscape) -->
        <LinearLayout
            android:id="@+id/navRail"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:background="@color/panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <View
            android:id="@+id/navDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Control page -->
            <LinearLayout
                android:id="@+id/pageControl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <!-- Toolbar: file + job -->
            <LinearLayout
                android:id="@+id/toolbarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/panel"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btnNew" style="@style/Tb" android:text="New" />
                        <Button android:id="@+id/btnOpen" style="@style/Tb" android:text="Open" />
                        <Button android:id="@+id/btnSave" style="@style/Tb" android:text="Save" />
                        <Button android:id="@+id/btnSaveAs" style="@style/Tb" android:text="Save As" />
                        <Button android:id="@+id/btnClose" style="@style/Tb" android:text="Close" />
                        <View android:layout_width="1dp" android:layout_height="28dp"
                            android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="#3A4048" />
                        <Button android:id="@+id/btnLoad" style="@style/Tb" android:background="@drawable/btn_accent" android:text="⇩ Load" android:textColor="@color/accent" />
                        <Button android:id="@+id/btnRun" style="@style/Tb" android:background="@drawable/btn_run" android:text="▶ Run" android:textColor="@color/ok" />
                        <Button android:id="@+id/btnHold" style="@style/Tb" android:background="@drawable/btn_hold" android:text="❚❚ Hold" android:textColor="@color/warn" />
                        <Button android:id="@+id/btnResume" style="@style/Tb" android:text="Resume" />
                        <Button android:id="@+id/btnStop" style="@style/Tb" android:background="@drawable/btn_stop" android:text="■ Stop" android:textColor="@color/err" />
                        <!-- feed override (realtime 0x90 reset, 0x91 / 0x92 ±10 %) -->
                        <View android:layout_width="1dp" android:layout_height="28dp"
                            android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:background="#3A4048" />
                        <TextView
                            android:id="@+id/txtFeedOv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="4dp"
                            android:singleLine="true"
                            android:text="Feed –"
                            android:textColor="#8B939C"
                            android:textSize="14sp" />
                        <Button android:id="@+id/ov50" style="@style/Tb" android:text="0.5×" />
                        <Button android:id="@+id/ov100" style="@style/Tb" android:text="1×" />
                        <Button android:id="@+id/ov200" style="@style/Tb" android:text="2×" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/progressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ProgressBar
                    android:id="@+id/progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000" />

                <TextView
                    android:id="@+id/txtJob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Not loaded"
                    android:textColor="#8B939C"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Left: machine -->
                <ScrollView
                    android:id="@+id/leftPanel"
                    android:layout_width="240dp"
                    android:layout_height="match_parent"
                    android:background="@color/panel">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Pro Mini only: Blue Pill is native USB and ignores the baud rate -->
                            <Spinner
                                android:id="@+id/baud"
                                android:layout_width="104dp"
                                android:layout_height="40dp" />

                            <Button
                                android:id="@+id/btnConnect"
                                style="@style/Btn"
                                android:layout_height="40dp"
                                android:background="@drawable/btn_accent"
                                android:textColor="@color/accent"
                                android:text="Connect" />
                        </LinearLayout>

                        <!-- DRO card: machine state, work position, machine position -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/dro_bg"
                            android:orientation="vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:id="@+id/txtState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="Disconnected"
                                android:textColor="#AAAAAA"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/txtPos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.04"
                                android:lineSpacingMultiplier="0.95"
                                android:text="X    0.000\nY    0.000\nZ    0.000"
                                android:textColor="@color/text"
                                android:textSize="19sp" />

                            <TextView
                                android:id="@+id/txtMPos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:text="MPos 0.000, 0.000, 0.000"
                                android:textColor="@color/muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtHome"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:text="Home X –  Y –  Z –"
                                android:textColor="@color/muted"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtFeed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:text="F – mm/min"
                                android:textColor="@color/muted"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <Button android:id="@+id/btnUnlock" style="@style/BtnRow" android:text="$X" />
                            <Button android:id="@+id/btnGoG54" style="@style/BtnRow" android:text="G54" />
                            <Button android:id="@+id/btnHome" style="@style/BtnRow" android:text="Home" />
                            <Button android:id="@+id/btnReset" style="@style/BtnRow" android:layout_marginEnd="0dp" android:text="Reset" />
                        </LinearLayout>

                        <!-- single-axis homing ($HX / $HY / $HZ) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/btnHomeX" style="@style/BtnRow" android:text="Home X" />
                            <Button android:id="@+id/btnHomeY" style="@style/BtnRow" android:text="Home Y" />
                            <Button android:id="@+id/btnHomeZ" style="@style/BtnRow" android:layout_marginEnd="0dp" android:text="Home Z" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/btnZeroXY" style="@style/BtnRow" android:text="0 XY" />
                            <Button android:id="@+id/btnZeroZ" style="@style/BtnRow" android:text="0 Z" />
                            <Button android:id="@+id/btnGoZero" style="@style/BtnRow" android:layout_marginEnd="0dp" android:text="→XY0" />
                        </LinearLayout>

                        <!-- Jog: step (mm) and feed (mm/min) in one row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioGroup
                                android:id="@+id/stepGroup"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal">

                                <RadioButton android:id="@+id/s01" style="@style/Seg" android:text=".1" />
                                <RadioButton android:id="@+id/s1" style="@style/Seg" android:text="1" android:checked="true" />
                                <RadioButton android:id="@+id/s10" style="@style/Seg" android:text="10" />
                                <RadioButton android:id="@+id/s50" style="@style/Seg" android:text="50" />
                            </RadioGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="3dp"
                                android:paddingEnd="3dp"
                                android:text="F"
                                android:textColor="@color/muted" />

                            <EditText
                                android:id="@+id/jogFeed"
                                android:layout_width="58dp"
                                android:layout_height="36dp"
                                android:background="@drawable/input_bg"
                                android:gravity="center"
                                android:inputType="number"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:selectAllOnFocus="true"
                                android:text="500"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <GridLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:columnCount="4"
                            android:rowCount="2">

                            <!-- arrow-key layout (2 rows) so Y− / Z− stay on screen above the nav bar -->
                            <Button android:id="@+id/jStop" style="@style/Jog" android:contentDescription="Cancel jog" android:text="■" android:textColor="@color/err" />
                            <Button android:id="@+id/jYp" style="@style/Jog" android:text="Y+" />
                            <Space android:layout_width="56dp" android:layout_height="46dp" />
                            <Button android:id="@+id/jZp" style="@style/Jog" android:text="Z+" />

                            <Button android:id="@+id/jXm" style="@style/Jog" android:text="X−" />
                            <Button android:id="@+id/jYm" style="@style/Jog" android:text="Y−" />
                            <Button android:id="@+id/jXp" style="@style/Jog" android:text="X+" />
                            <Button android:id="@+id/jZm" style="@style/Jog" android:text="Z−" />
                        </GridLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- Middle: editor / console -->
                <LinearLayout
                    android:id="@+id/middlePanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/tabEditor" style="@style/Tab" android:text="Editor" />
                        <Button android:id="@+id/tabConsole" style="@style/Tab" android:text="Console" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <org.dnaboy.grblsender.GCodeEditor
                            android:id="@+id/editor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <org.dnaboy.grblsender.GCodeViewer
                            android:id="@+id/viewer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <ScrollView
                            android:id="@+id/logScroll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#070A0E"
                            android:padding="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtLog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="12sp"
                                android:textColor="#B9E3B9"
                                android:textIsSelectable="true" />
                        </ScrollView>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/cmdInput"
                            android:background="@drawable/input_bg"
                            android:padding="8dp"
                            android:layout_margin="4dp"
                            android:fontFamily="monospace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="G-code or $ command"
                            android:imeOptions="actionSend"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#777777" />

                        <Button
                            android:id="@+id/btnSend"
                            style="@style/Tb"
                            android:text="Send" />

                        <Button
                            android:id="@+id/btnSettings"
                            style="@style/Tb"
                            android:text="$$" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right: toolpath preview -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <org.dnaboy.grblsender.ToolpathView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnFit"
                            style="@style/Tb"
                            android:text="Fit" />

                        <Button
                            android:id="@+id/btnFull"
                            style="@style/Tb"
                            android:minWidth="48dp"
                            android:textSize="20sp"
                            android:contentDescription="Full screen preview"
                            android:text="⛶" />
                    </LinearLayout>

                    <!-- Shown only in full-screen mode: keep Hold/Stop within reach while the job runs -->
                    <LinearLayout
                        android:id="@+id/fullControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="28dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/fullState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="#CC0B0F14"
                            android:padding="8dp"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button android:id="@+id/fullOv50" style="@style/Tb" android:text="0.5×" />
                        <Button android:id="@+id/fullOv100" style="@style/Tb" android:text="1×" />
                        <Button android:id="@+id/fullOv200" style="@style/Tb" android:text="2×" />
                        <Button android:id="@+id/fullHold" style="@style/Tb" android:background="@drawable/btn_hold" android:text="❚❚ Hold" android:textColor="@color/warn" />
                        <Button android:id="@+id/fullResume" style="@style/Tb" android:text="Resume" />
                        <Button android:id="@+id/fullStop" style="@style/Tb" android:background="@drawable/btn_stop" android:text="■ Stop" android:textColor="@color/err" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            </LinearLayout>

            <!-- Settings page (built in code) -->
            <FrameLayout
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
